<?xml version="1.0" encoding="utf-8"?>
<!-- Kamera uygulamasının yazabileceği tek yer: cacheDir/camera (ADR-0010). Şifreli fotoğraflar (filesDir/photos)
     bu sağlayıcıdan erişilemez; dışa aktarma kullanıcının seçtiği SAF adresine yapılır. -->
<paths>
    <cache-path name="camera" path="camera/" />
    <!-- Doktor raporu PDF'leri (ADR-0009): paylaşım menüsüne yalnızca bu klasör, okuma izniyle açılır. -->
    <cache-path name="raporlar" path="raporlar/" />
</paths>
