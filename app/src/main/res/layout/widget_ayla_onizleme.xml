<?xml version="1.0" encoding="utf-8"?>
<!-- Widget seçicideki önizleme (Android 12+): yalnızca sabit örnek veri, kullanıcının verisi değil. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_zemin"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_onizleme_etiket"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:text="@string/widget_overline_cycle"
        android:textColor="@color/widget_murekkep_soluk"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_onizleme_baslik"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/widget_preview_headline"
        android:textColor="@color/widget_murekkep"
        android:textSize="20sp" />

    <FrameLayout
        android:id="@+id/widget_bosluk_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_onizleme_doz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/widget_preview_dose"
        android:textColor="@color/widget_murekkep"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_onizleme_aldim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_dugme"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:minHeight="48dp"
        android:paddingHorizontal="12dp"
        android:text="@string/widget_taken"
        android:textColor="@color/widget_nar_uzeri"
        android:textSize="15sp" />

</LinearLayout>
