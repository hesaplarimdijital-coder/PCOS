    <string name="onboarding_period_unknown">Bilmiyorum</string>
    <string name="onboarding_consent_title">İzinlerin sende</string>
    <string name="onboarding_consent_text">Sağlık verin KVKK&#8217;ya göre özel nitelikli kişisel veridir. Ayla&#8217;nın çalışması için kayıtların yalnızca bu cihazda ve şifreli olarak işlenir; hiçbir yere gönderilmez.</string>
    <string name="consent_personalization_title">Kişiselleştirme</string>
    <string name="consent_health_title">Açık rıza</string>
    <string name="consent_health_text">Adet, günlük kayıt, ilaç, su ve uyku kayıtlarımın bu cihazda işlenmesine, aydınlatma metnini okuyarak açık rıza veriyorum.</string>
    <string name="consent_health_required">Başlamak için açık rızanı işaretlemelisin.</string>
    <string name="consent_dialog_title">Açık rızan gerekiyor</string>
    <string name="consent_dialog_text">Ayla kayıtlarını yalnızca bu cihazda ve şifreli işler. Devam etmek için sağlık verilerinin bu şekilde işlenmesine açık rıza vermen gerekiyor. Gizlilik politikasını ve aydınlatma metnini okuyabilirsin.</string>
    <string name="consent_dialog_accept">Okudum, onaylıyorum</string>
    <string name="privacy_policy_title">Gizlilik politikası</string>
