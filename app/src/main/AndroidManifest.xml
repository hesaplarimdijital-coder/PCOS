<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Hatırlatmalar -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Uygulama kilidi -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Health Connect: yalnızca uyku okuma (#11). Başka android.permission.health.* izni eklenmez;
         Play Console'da Health Connect beyanı: docs/play/health-connect-beyani.md -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <!-- Android 11–13: Health Connect uygulaması getSdkStatus için görünür olsun -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".AylaApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ayla.Starting"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Ayla.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Health Connect izin ekranındaki "Gizlilik politikası" bağlantısı (Android 13 ve altı) -->
        <activity
            android:name=".PermissionsRationaleActivity"
            android:exported="true"
            android:theme="@style/Theme.Ayla">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Aynı ekran, Android 14 ve üstü. Takma ad hedef etkinlikten sonra tanımlanmalı. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".PermissionsRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Ana ekran widget'ı (#14, ADR-0007): RemoteViews, periyodik güncelleme yok -->
        <receiver
            android:name=".widget.AylaWidgetProvider"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ayla_widget_info" />
        </receiver>

        <!-- Alarm tetiklendiğinde bildirimi gösterir ve sıradaki alarmı kurar -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />

        <!-- Bildirim eylemleri: Aldım, Ertele -->
        <receiver
            android:name=".reminders.ReminderActionReceiver"
            android:exported="false" />

        <!-- Yeniden başlatma, saat/dilim değişimi ve izin değişiminde alarmları yeniden kurar -->
        <receiver
            android:name=".reminders.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Cilt/saç fotoğrafları (#25, ADR-0010): kamera uygulamasının geçici düz dosyayı yazacağı tek adres
             (cacheDir/camera). Dışa kapalı; yazma izni yalnızca ACTION_IMAGE_CAPTURE niyetiyle, tek dosya için,
             sistem tarafından verilir. CAMERA ya da depolama izni istenmez; şifreli fotoğraflar buradan sunulmaz. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/photo_paths" />
        </provider>
    </application>
</manifest>
